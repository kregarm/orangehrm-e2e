#!/usr/bin/env bash
#
# Runs the Playwright E2E suite against a disposable OrangeHRM instance.
#
# The environment is provisioned the same way the Cypress suite expects:
# orangehrm-os-dev-environment with nginx, PHP and MySQL 5.5, the CLI installer with the functional-test admin, and
# tools/prepare.php for the functional-testing plugin. The app is served as
# http://php83/web/index.php; Playwright runs on the host.
#
# PHP defaults to 8.3 rather than Cypress' 8.0: the dev environment's PHP 8.0
# image is based on Debian bullseye, which is EOL, so it no longer builds.
#
# To keep the working tree and any running dev environment untouched, the
# source is copied to a temp dir and started as a separate compose project on
# free ports. Everything is torn down on exit.
#
# Usage: bin/run-e2e [--headfull] [playwright test args...]
#   --headfull  show the browser window (default: headless)
#   e.g. bin/run-e2e --headfull playwright/e2e/feature/core/login.spec.ts
#
# Environment:
#   ORANGEHRM_DEV_ENV_DIR    existing orangehrm-os-dev-environment checkout
#   ORANGEHRM_DEV_ENV_CACHE  where to clone it otherwise
#                            (default: ~/.cache/orangehrm-os-dev-environment)
#   E2E_HTTP_PORT, E2E_HTTPS_PORT, E2E_MYSQL_PORT
#                            host ports (default: any free port)
#   E2E_PHP_VERSION          dev-environment PHP service (default: 8.3),
#                            e.g. 8.4 -> php-8.4 served as php84
#   PLAYWRIGHT_INSTALL_DEPS  "true" to also install Chromium's OS packages (CI)

set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FUNCTIONAL_DIR="$PROJECT_ROOT/src/test/functional"
DB_SERVICE=mysql55
PROJECT_NAME="orangehrm-e2e-$(date +%s)-$$"
RUN_ROOT=""
DOCKER_CONFIG_DIR="${DOCKER_CONFIG:-$HOME/.docker}"

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

log() {
  printf '\n==> %s\n' "$*"
}

# Translate our flags; everything else is passed to `playwright test`.
PLAYWRIGHT_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --headfull) PLAYWRIGHT_ARGS+=(--headed) ;;
    *) PLAYWRIGHT_ARGS+=("$arg") ;;
  esac
done

E2E_PHP_VERSION="${E2E_PHP_VERSION:-8.3}"
[[ "$E2E_PHP_VERSION" =~ ^[0-9]+\.[0-9]+$ ]] || fail "Invalid E2E_PHP_VERSION: $E2E_PHP_VERSION"
PHP_SERVICE="php-$E2E_PHP_VERSION"
APP_HOST="php${E2E_PHP_VERSION/./}"

# --- Prerequisites ----------------------------------------------------------

if ! command -v docker >/dev/null 2>&1 && [[ -x "$HOME/.docker/bin/docker" ]]; then
  export PATH="$HOME/.docker/bin:$PATH"
fi
for cmd in docker node corepack curl git tar; do
  command -v "$cmd" >/dev/null 2>&1 || fail "Required command not found: $cmd"
done
docker info >/dev/null 2>&1 || fail "Docker daemon is not reachable. Is Docker running?"

# --- Dev environment checkout -----------------------------------------------

DEV_ENV_DIR="${ORANGEHRM_DEV_ENV_DIR:-}"
if [[ -z "$DEV_ENV_DIR" ]]; then
  # The documented layout checks OrangeHRM out inside the dev environment.
  candidate="$(dirname "$PROJECT_ROOT")"
  while [[ "$candidate" != "/" ]]; do
    if [[ -f "$candidate/docker-compose.yml" ]]; then
      DEV_ENV_DIR="$candidate"
      break
    fi
    candidate="$(dirname "$candidate")"
  done
fi
if [[ -z "$DEV_ENV_DIR" ]]; then
  DEV_ENV_DIR="${ORANGEHRM_DEV_ENV_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/orangehrm-os-dev-environment}"
  if [[ ! -f "$DEV_ENV_DIR/docker-compose.yml" ]]; then
    log "Cloning orangehrm-os-dev-environment into $DEV_ENV_DIR"
    mkdir -p "$(dirname "$DEV_ENV_DIR")"
    git clone --depth 1 https://github.com/orangehrm/orangehrm-os-dev-environment.git "$DEV_ENV_DIR"
  fi
fi
[[ -f "$DEV_ENV_DIR/docker-compose.yml" ]] || fail "No docker-compose.yml in $DEV_ENV_DIR"
[[ -f "$DEV_ENV_DIR/.env.dist" ]] || fail "No .env.dist in $DEV_ENV_DIR"

# --- Ports ------------------------------------------------------------------

free_port() {
  node -e '
    const server = require("node:net").createServer();
    server.listen(0, "127.0.0.1", () => {
      console.log(server.address().port);
      server.close();
    });
  '
}

E2E_HTTP_PORT="${E2E_HTTP_PORT:-$(free_port)}"
E2E_HTTPS_PORT="${E2E_HTTPS_PORT:-$(free_port)}"
E2E_MYSQL_PORT="${E2E_MYSQL_PORT:-$(free_port)}"
for port in "$E2E_HTTP_PORT" "$E2E_HTTPS_PORT" "$E2E_MYSQL_PORT"; do
  [[ "$port" =~ ^[0-9]+$ ]] && ((port >= 1 && port <= 65535)) ||
    fail "Invalid port: $port"
done

# --- Isolated source copy and compose project -------------------------------

RUN_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/orangehrm-e2e.XXXXXX")"
SOURCE_DIR="$RUN_ROOT/html"

cleanup() {
  local status=$?
  trap - EXIT
  set +e
  log "Tearing down $PROJECT_NAME"
  # On Linux, files the containers created in the bind mount are root-owned;
  # hand them back so the copy and logs can be removed and read.
  docker exec "$PROJECT_NAME-php" chown -R "$(id -u):$(id -g)" /var/www >/dev/null 2>&1
  compose down --volumes --remove-orphans >/dev/null 2>&1
  if [[ -d "$SOURCE_DIR/src/log" ]]; then
    rm -rf "$FUNCTIONAL_DIR/e2e-logs"
    cp -R "$SOURCE_DIR/src/log" "$FUNCTIONAL_DIR/e2e-logs"
  fi
  rm -rf "$RUN_ROOT"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Copy what a fresh checkout would contain (tracked files plus new, unignored
# ones), like a CI checkout, including local edits.
log "Copying source to $SOURCE_DIR"
mkdir -p "$SOURCE_DIR"
(
  cd "$PROJECT_ROOT"
  git ls-files -z --cached --others --exclude-standard |
    while IFS= read -r -d '' file; do
      # Skip tracked files deleted in the working tree.
      if [[ -e "$file" || -L "$file" ]]; then printf '%s\0' "$file"; fi
    done |
    tar --null -T - -cf -
) | tar -xf - -C "$SOURCE_DIR"
mkdir -p "$SOURCE_DIR/src/log" "$SOURCE_DIR/src/config"

# The dev-environment pins container names (os_dev_*), so give this project
# its own to run alongside an existing dev environment. MySQL 5.5 has no arm64
# image; pin amd64 so it runs under emulation on Apple Silicon.
cp "$DEV_ENV_DIR/.env.dist" "$RUN_ROOT/.env"
cat >"$RUN_ROOT/compose.override.yml" <<EOF
services:
  nginx:
    container_name: $PROJECT_NAME-nginx
  $PHP_SERVICE:
    container_name: $PROJECT_NAME-php
  $DB_SERVICE:
    container_name: $PROJECT_NAME-db
    platform: linux/amd64
EOF
touch "$RUN_ROOT/.bash_history"

compose() {
  # HOME is redirected because the PHP service bind-mounts $HOME/.bash_history;
  # DOCKER_CONFIG keeps the docker CLI using the real config.
  HOME="$RUN_ROOT" \
    DOCKER_CONFIG="$DOCKER_CONFIG_DIR" \
    LOCAL_SRC="$SOURCE_DIR" \
    NGINX_PORT="$E2E_HTTP_PORT" \
    NGINX_SSL_PORT="$E2E_HTTPS_PORT" \
    MYSQL_55_PORT="$E2E_MYSQL_PORT" \
    docker compose \
    --project-directory "$DEV_ENV_DIR" \
    --env-file "$RUN_ROOT/.env" \
    --file "$DEV_ENV_DIR/docker-compose.yml" \
    --file "$RUN_ROOT/compose.override.yml" \
    --project-name "$PROJECT_NAME" \
    "$@"
}

php_exec() {
  docker exec "$PROJECT_NAME-php" bash --login -c "$1"
}

# --- Provision ---------------------------------------------------------------

log "Starting nginx, $PHP_SERVICE and $DB_SERVICE ($PROJECT_NAME)"
compose up --detach --build "$PHP_SERVICE" "$DB_SERVICE" ||
  fail "Could not build or start $PHP_SERVICE/$DB_SERVICE (see the docker output above). Some older dev-environment PHP images no longer build; try another E2E_PHP_VERSION."

log "Installing dependencies and building the frontend"
php_exec 'cd src && composer install --no-interaction'
php_exec 'cd src/client && yarn install --immutable && yarn build --mode development'

log "Waiting for $DB_SERVICE"
for _ in {1..60}; do
  docker exec "$PROJECT_NAME-db" mysqladmin ping -uroot -proot --silent >/dev/null 2>&1 && break
  sleep 2
done
docker exec "$PROJECT_NAME-db" mysqladmin ping -uroot -proot --silent >/dev/null 2>&1 ||
  fail "$DB_SERVICE did not become ready"

log "Installing OrangeHRM"
php_exec "
  set -e
  sed -i 's/hostName: 127.0.0.1/hostName: $DB_SERVICE/g' installer/cli_install_config.yaml
  sed -i 's/adminPassword: Ohrm@1423/adminPassword: Jacqueline@OHRM123/g' installer/cli_install_config.yaml
  sed -i 's/adminEmployeeFirstName: OrangeHRM/adminEmployeeFirstName: Jacqueline/g' installer/cli_install_config.yaml
  sed -i 's/adminEmployeeLastName: Admin/adminEmployeeLastName: White/g' installer/cli_install_config.yaml
  sed -i 's/public const PRODUCT_MODE = self::MODE_PROD/public const PRODUCT_MODE = self::MODE_DEV/g' src/lib/config/Config.php
  chmod -R 777 src/log src/config
  php installer/cli_install.php
  php src/test/functional/tools/prepare.php
"

# --- Run Playwright ---------------------------------------------------------

export PLAYWRIGHT_BASE_URL="http://$APP_HOST:$E2E_HTTP_PORT/web/index.php"
# Resolve the app host to the published nginx port without touching /etc/hosts.
export E2E_LOCAL_HOSTS="$APP_HOST"

log "Waiting for $PLAYWRIGHT_BASE_URL"
for _ in {1..60}; do
  curl --fail --silent --output /dev/null \
    --resolve "$APP_HOST:$E2E_HTTP_PORT:127.0.0.1" \
    "$PLAYWRIGHT_BASE_URL/auth/login" && break
  sleep 2
done
curl --fail --silent --output /dev/null \
  --resolve "$APP_HOST:$E2E_HTTP_PORT:127.0.0.1" \
  "$PLAYWRIGHT_BASE_URL/auth/login" ||
  fail "OrangeHRM did not become ready at $PLAYWRIGHT_BASE_URL"

log "Running Playwright"
cd "$FUNCTIONAL_DIR"
corepack yarn install --immutable
if [[ "${PLAYWRIGHT_INSTALL_DEPS:-false}" == "true" ]]; then
  corepack yarn playwright install --with-deps chromium
else
  corepack yarn playwright install chromium
fi
corepack yarn test:playwright ${PLAYWRIGHT_ARGS[@]+"${PLAYWRIGHT_ARGS[@]}"}
